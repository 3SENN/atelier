{
  "name": "atelierbrowser",
  "productName": "Atelier",
  "version": "1.6.1",
  "description": "Atelier, the browser you make your own: a companion that works in your tabs and builds the tools you describe.",
  "homepage": "https://atelierbrowser.eu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3SENN/atelier.git"
  },
  "bugs": {
    "url": "https://github.com/3SENN/atelier/issues"
  },
  "author": "Senne Chin",
  "license": "MPL-2.0 AND LicenseRef-Atelier-Companion-Art",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/dev-branding.mjs && node scripts/kit/build.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/kit/build.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "smoke": "electron-vite build && node scripts/kit/build.mjs && node scripts/smoke.mjs",
    "package": "node scripts/release/preflight.mjs && node scripts/licenses.mjs && electron-vite build && node scripts/kit/build.mjs && node scripts/build-speech-helper.mjs && node scripts/build-calendar-helper.mjs && (node scripts/build-translate-helper.mjs || echo Shipping without on-device translation) && (node scripts/fetch-decision-model.mjs || echo Shipping without the on-device decision model) && (node scripts/build-native.mjs || echo Shipping without trackpad haptics) && node scripts/internal.mjs prepackage && electron-builder --config electron-builder.config.mjs",
    "companion:assets": "node scripts/companion-assets/generate.mjs",
    "icons": "node scripts/app-icons/generate.mjs --release-art && node scripts/app-icons/unofficial.mjs",
    "licenses": "node scripts/licenses.mjs",
    "i18n:check": "node scripts/i18n/check.mjs",
    "package:mac": "node scripts/release/release.mjs --mac --package-only",
    "package:win": "node scripts/release/release.mjs --win --package-only",
    "package:linux": "node scripts/release/release.mjs --linux --package-only",
    "release": "node scripts/release/release.mjs",
    "asc": "node scripts/release/asc.mjs",
    "smoke:packaged": "node scripts/release/smoke-packaged.mjs",
    "postinstall": "electron-builder install-app-deps && node scripts/dev-branding.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@fontsource-variable/inter": "5.3.0",
    "@ghostery/adblocker-electron": "2.20.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@mozilla/readability": "0.6.0",
    "ajv": "8.20.0",
    "electron-updater": "6.8.11",
    "fflate": "0.8.3",
    "lucide-react": "1.77.0",
    "node-forge": "1.4.3",
    "onnxruntime-node": "1.31.1",
    "pdfjs-dist": "6.5.438",
    "qrcode-generator": "2.0.4",
    "three": "0.186.1",
    "tldts": "7.5.5",
    "ws": "^8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@huggingface/tokenizers": "0.2.0",
    "@types/node": "24.19.2",
    "@types/node-forge": "1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "linkedom": "0.18.15",
    "meshoptimizer": "1.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
